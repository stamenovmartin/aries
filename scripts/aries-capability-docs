#!/usr/bin/env python3
"""Regenerate the capability table in docs/CAPABILITIES.md from the live registry.

WHY THIS EXISTS
---------------
The table was hand-maintained and went stale exactly the way hand-maintained
lists do: on 2026-09-30 the registry held 58 capabilities and the table listed
about twenty, missing every `screen.*`, `network.*`, `display.*`, `input.*` and
`system.service*` entry added that day. A documentation file that disagrees with
the code is worse than no file, because a reader trusts it.

So the table is generated and the prose is not. Everything between the two
markers is replaced; everything around them is left exactly as written, because
the reasoning in that prose is not derivable from anything.

The generated description column is each Capability's own `description`, which is
what the planner is shown. That is a real trade: the old hand-written column said
more about independent observation for the entries it covered. A complete table
that cannot drift beats a richer one that is two-thirds absent.

    ./scripts/aries-capability-docs            rewrite the table
    ./scripts/aries-capability-docs --check     exit 1 if it is out of date
"""
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]

# Re-exec under the project interpreter. sqlalchemy and the rest live in .venv
# and not on the system python, so importing the registry from /usr/bin/python3
# fails on the first dependency — the same reason scripts/aries-voice is a
# wrapper rather than a plain entry point.
VENV = ROOT / ".venv" / "bin" / "python"
if Path(sys.executable).resolve() != VENV.resolve() and VENV.is_file():
    os.execv(str(VENV), [str(VENV), str(Path(__file__).resolve()), *sys.argv[1:]])

for p in (ROOT / "vendor" / "agentic-core", ROOT / "vendor", ROOT):
    sys.path.insert(0, str(p))
os.environ.setdefault("APP_ENV", "test")      # never touch live settings to read metadata

DOC = ROOT / "docs" / "CAPABILITIES.md"
START = "<!-- generated: ./scripts/aries-capability-docs -->"
END = "<!-- end generated -->"


def fields(model):
    """The input field names a caller must supply, in declaration order."""
    try:
        return list(getattr(model, "model_fields", {}))
    except Exception:                                  # noqa: BLE001 - a doc tool never raises
        return []


def table():
    from aries.workspace.registry import registry
    rows = ["| Capability | Input | Effect | Approval | Description |",
            "|---|---|---|---|---|"]
    for name in sorted(registry._items):
        item = registry._items[name]
        names = fields(getattr(item, "input_model", None)) or ["none"]
        gate = "**yes**" if getattr(item, "requires_approval", False) else "—"
        text = (getattr(item, "description", "") or "").replace("|", "\\|").strip()
        rows.append(f"| `{name}` | {', '.join(names)} | `{getattr(item, 'effect', 'read')}` | {gate} | {text} |")
    reads = sum(1 for n in registry._items if getattr(registry._items[n], "effect", "read") == "read")
    gated = sum(1 for n in registry._items if getattr(registry._items[n], "requires_approval", False))
    rows.append("")
    rows.append(f"{len(registry._items)} capabilities: {reads} observe only, "
                f"{len(registry._items) - reads} change something, {gated} require approval.")
    return "\n".join(rows)


def main():
    text = DOC.read_text()
    if START not in text or END not in text:
        print(f"markers missing in {DOC}; add {START} and {END} around the table", file=sys.stderr)
        return 2
    head, rest = text.split(START, 1)
    _, tail = rest.split(END, 1)
    fresh = head + START + "\n" + table() + "\n" + END + tail
    if "--check" in sys.argv:
        if fresh != text:
            print("docs/CAPABILITIES.md is out of date; run ./scripts/aries-capability-docs", file=sys.stderr)
            return 1
        print("docs/CAPABILITIES.md matches the registry")
        return 0
    DOC.write_text(fresh)
    print(f"rewrote the table in {DOC.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
