#!/usr/bin/env python3
"""Write goals that did not succeed into eval/triage_queue/ for the weekly review.

WHY A SCRIPT AND NOT A HOOK IN THE FAILURE PATH
-----------------------------------------------
Writing the queue the moment a goal fails would mean a hook inside
`aries/workspace/service.py`, which another agent holds today, and it would put a
file write on the failure path — the one path that should do as little as possible.
Failures are already durable in `aries_workspace_goals`, so this derives the queue
from them and can be re-run at any time without losing anything.

It is idempotent: one file per day, overwritten, so running it twice does not create
two queues to disagree with each other.

Usage:
  scripts/aries-triage-queue              last 7 days
  scripts/aries-triage-queue --days 14
  scripts/aries-triage-queue --print      also print the grouped summary
"""
from __future__ import annotations

import argparse
import asyncio
import json
import pathlib
import sys
from collections import Counter
from datetime import date

ROOT = pathlib.Path(__file__).resolve().parents[1]
for p in (ROOT / 'vendor/agentic-core', ROOT / 'vendor', ROOT):
    sys.path.insert(0, str(p))

OUT_DIR = ROOT / 'eval/triage_queue'


async def main(days: int, show: bool) -> int:
    from agentic_core.database.base import async_session
    from aries import flags
    from aries.workspace import traces
    async with async_session() as db:
        rows = await traces.failures(db, days=days)

    by_code = Counter(code for row in rows for code in row['error_codes'] or ['(no typed code)'])
    by_state = Counter(row['state'] for row in rows)
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    target = OUT_DIR / f'{date.today().isoformat()}-failures.json'
    target.write_text(json.dumps({
        'written': date.today().isoformat(),
        'window_days': days,
        'n': len(rows),
        'by_state': dict(by_state),
        'by_error_code': dict(by_code.most_common()),
        'settings': flags.describe(),
        'note': 'Derived from aries_workspace_goals. A goal appears here because it did not '
                'succeed, not because its cause is known. An entry with no typed error code is '
                'the one worth opening first: it failed without saying why.',
        'goals': rows,
    }, ensure_ascii=False, indent=2))
    print(f'wrote {target.relative_to(ROOT)} — {len(rows)} goal(s) over {days} day(s)')
    if show or True:
        print(f'  by state: {dict(by_state)}')
        for code, n in by_code.most_common(8):
            print(f'  {n:4d}  {code}')
        untyped = by_code.get('(no typed code)', 0)
        if untyped:
            print(f'\n{untyped} failure(s) carry NO typed error code — those are the ones that '
                  f'failed without saying why.')
    return 0


if __name__ == '__main__':
    ap = argparse.ArgumentParser()
    ap.add_argument('--days', type=int, default=7)
    ap.add_argument('--print', action='store_true')
    cli = ap.parse_args()
    raise SystemExit(asyncio.run(main(cli.days, cli.print)))
