# ─── agentic-core: environment ───────────────────────────────────────────────
# Copy to .env. Every secret is empty on purpose; nothing has a working default.
# The safety switches default SAFE: DRY_RUN=true and LIVE_TOOLS="" mean no
# side-effecting tool ever runs for real until you flip both.

# Environment: development | test | staging | production  (missing = production)
APP_ENV=development
FASTAPI_ENV=development
LOG_LEVEL=INFO

# Storage. SQLite for a laptop; docker-compose overrides with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./data/agentic_core.db
# DATABASE_URL=postgresql+asyncpg://agentic:${POSTGRES_PASSWORD}@postgres:5432/agentic_core
POSTGRES_USER=agentic
POSTGRES_PASSWORD=
POSTGRES_DB=agentic_core
REDIS_URL=

# App / auth. API_KEY empty = open API (only on a trusted LAN). SECRET_KEY required in production.
APP_NAME=agentic-core
API_KEY=
SECRET_KEY=
CORS_ORIGINS=http://localhost:3000
DATA_DIR=./data

# Credentials at rest (security/crypto.py). Generate with:
#   python -c "from agentic_core.security.crypto import generate_key; print(generate_key())"
CREDENTIALS_KEY=

# LLM provider: template | cli | ollama | openai
AI_PROVIDER=template
REQUIRE_AI=false
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
# cli: an installed agentic CLI in headless mode (claude / codex). Auth comes
# from the CLI's own login (mounted ~/.claude or ~/.codex), never from here.
CLI_AGENT_BIN=claude
CLI_AGENT_MODEL=claude-haiku-4-5
CLI_AGENT_TIMEOUT=60
CLI_AGENT_MAX_CONCURRENCY=2
# ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120
# openai-compatible (OpenAI, Groq, vLLM, LM Studio…)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Approval channel (optional). The bot long-polls; no public URL needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_CHAT_ID=
TELEGRAM_POLL_ENABLED=true

# Execution safety. Both must open for a side-effecting tool to run for real.
DRY_RUN=true
LIVE_TOOLS=
SANDBOX_TIMEOUT_S=30
SANDBOX_ALLOWED_COMMANDS=ls,cat,stat,df,du,free,uptime,systemctl status,journalctl,ps,ss,ip,hostname,uname,id,whoami,which,echo,head,tail,grep,wc,find
MAX_ACTIONS_PER_HOUR=30

# Scheduler / workers
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
SCHEDULER_MAX_ATTEMPTS=3
SCHEDULER_RETRY_BACKOFF_MINUTES=5
QUIET_HOURS_START=0
QUIET_HOURS_END=0
SCHEDULER_TIMEZONE=UTC
LEARNING_NIGHTLY_ENABLED=true
LEARNING_RUN_HOUR=3

# Memory
MEMORY_EMBEDDINGS=lexical

# Optional: import an application package on startup (registers agents/tools/kinds)
AGENTIC_APP=
